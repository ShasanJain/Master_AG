{
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.tmp": true,
    "**/*.db": true,
    "**/*.log": true,
    "**/graphify-out/cache": true,
    "**/graphify-out/graph.json": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.tmp": true,
    "**/*.db": true,
    "**/graphify-out/cache": true
  },
  "files.watcherExclude": {
    "**/node_modules/*/**": true,
    "**/.next/*/**": true,
    "**/graphify-out/cache/*/**": true,
    "**/.git/*/**": true
  },
  "python.analysis.extraPaths": [
    "./execution"
  ],
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  }
}
