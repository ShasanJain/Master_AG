{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Config",
  "type": "object",
  "required": ["engine", "default_user", "sectors"],
  "properties": {
    "engine":               { "type": "string", "enum": ["openmemory", "deeplake"] },
    "default_user":         { "type": "string", "minLength": 1 },
    "sectors":              { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "auto_capture":         { "type": "boolean" },
    "embedding_provider":   { "type": "string" },
    "notes":                { "type": "string" }
  }
}
